<?xml version="1.0" encoding="utf-8"?>
<!--
  Voyager - WiX Toolset v4/v6 schema (Windows 上で `wix build` する用)

    wix build -arch x64 -o Voyager-1.0.0-x64.msi Voyager.v6.wxs

  Voyager.exe / WebView2Loader.dll / Voyager.ico を同じフォルダに置いてから実行する。
  文字列は ASCII のみ（MSI データベースのコードページ問題を避けるため）。
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- ビルドごとに版番号を進める（同一バージョンだと MSI はファイルを置き換えない）:
         wix build -d Ver=1.0.7 ... -->
  <?ifndef Ver ?>
  <?define Ver = "1.0.0" ?>
  <?endif?>

  <Package Name="Voyager"
           Manufacturer="K-S System"
           Version="$(Ver)"
           UpgradeCode="DCD34823-C2C2-49D4-ADD5-F5641FCB401D"
           Scope="perUser"
           Compressed="yes"
           InstallerVersion="500">

    <SummaryInformation Description="Voyager - AI browser based on WebView2" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Voyager is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="VoyagerIcon" SourceFile="Voyager.ico" />
    <Property Id="ARPPRODUCTICON" Value="VoyagerIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Voyager" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="ProgramMenuFolder" />

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">

      <Component Id="C.MainExe" Guid="E1D1F58C-5F2A-4359-9A7D-C4185521416C">
        <File Id="F.Voyager.exe" Name="Voyager.exe" Source="Voyager.exe" KeyPath="yes">
          <Shortcut Id="S.Desktop"
                    Directory="DesktopFolder"
                    Name="Voyager"
                    Description="Voyager - AI browser"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="VoyagerIcon"
                    Advertise="no" />
          <Shortcut Id="S.StartMenu"
                    Directory="ProgramMenuFolder"
                    Name="Voyager"
                    Description="Voyager - AI browser"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="VoyagerIcon"
                    Advertise="no" />
        </File>
        <RemoveFolder Id="R.InstallFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\K-S System\Voyager"
                       Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" />
      </Component>

      <Component Id="C.Loader" Guid="B7FF2AF7-6A9B-489A-9418-632D10FBBAC0">
        <File Id="F.WebView2Loader.dll" Name="WebView2Loader.dll"
              Source="WebView2Loader.dll" KeyPath="yes" />
      </Component>

    </ComponentGroup>

    <Feature Id="Main" Title="Voyager">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>

  </Package>
</Wix>
