<?xml version="1.0" encoding="utf-8"?>
<!--
  Voyager - Windows Installer (MSI)

  ・ユーザー単位インストール（UAC なし）: %LOCALAPPDATA%\Programs\Voyager
  ・「アプリと機能」に登録され、そこからアンインストールできる
  ・同じ UpgradeCode の旧バージョンは上書き時に置き換わる

  ビルド:
    Linux/macOS : wixl -a x64 -o Voyager-1.0.0-x64.msi Voyager.wxs
    Windows     : candle Voyager.wxs && light Voyager.wixobj   (WiX v3)
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Voyager"
           Language="1041"
           Codepage="65001"
           Version="1.0.0"
           Manufacturer="K-S System"
           UpgradeCode="DCD34823-C2C2-49D4-ADD5-F5641FCB401D">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perUser"
             Description="Voyager - WebView2 ベースの AI ブラウザ"
             Manufacturer="K-S System"
             Languages="1041"
             SummaryCodepage="65001" />

    <Media Id="1" Cabinet="voyager.cab" EmbedCab="yes" />

    <!-- ユーザー単位インストール（管理者権限を要求しない） -->
    <Property Id="ALLUSERS" Value="2" />
    <Property Id="MSIINSTALLPERUSER" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPPRODUCTICON" Value="VoyagerIcon" />

    <Icon Id="VoyagerIcon" SourceFile="Voyager.ico" />

    <!-- 旧バージョンの検出（同一 UpgradeCode） -->
    <Upgrade Id="DCD34823-C2C2-49D4-ADD5-F5641FCB401D">
      <UpgradeVersion Minimum="0.0.0" IncludeMinimum="yes"
                      Maximum="1.0.0" IncludeMaximum="no"
                      Property="OLDVERSIONFOUND" />
      <UpgradeVersion Minimum="1.0.0" IncludeMinimum="yes"
                      OnlyDetect="yes" Property="NEWERVERSIONFOUND" />
    </Upgrade>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLDIR" Name="Voyager">

            <Component Id="C.MainExe" Guid="E1D1F58C-5F2A-4359-9A7D-C4185521416C">
              <File Id="F.Voyager.exe" Name="Voyager.exe" Source="Voyager.exe" KeyPath="yes" />


              <Shortcut Id="S.Desktop" Directory="DesktopFolder" Name="Voyager"
                        Description="Voyager - AI browser"
                        Target="[INSTALLDIR]Voyager.exe" WorkingDirectory="INSTALLDIR" Icon="VoyagerIcon" />
              <Shortcut Id="S.StartMenu" Directory="ProgramMenuFolder" Name="Voyager"
                        Description="Voyager - AI browser"
                        Target="[INSTALLDIR]Voyager.exe" WorkingDirectory="INSTALLDIR" Icon="VoyagerIcon" />
              <RemoveFolder Id="R.InstallDir" On="uninstall" />
              <RegistryValue Root="HKCU" Key="Software\K-S System\Voyager"
                             Name="InstallDir" Type="string" Value="[INSTALLDIR]" />
            </Component>

            <Component Id="C.Loader" Guid="B7FF2AF7-6A9B-489A-9418-632D10FBBAC0">
              <File Id="F.WebView2Loader.dll" Name="WebView2Loader.dll"
                    Source="WebView2Loader.dll" KeyPath="yes" />
            </Component>

          </Directory>
        </Directory>
      </Directory>

      <Directory Id="DesktopFolder" Name="Desktop" />
      <Directory Id="ProgramMenuFolder" Name="Programs" />
    </Directory>

    <InstallExecuteSequence>
      <RemoveExistingProducts After="InstallInitialize" />
    </InstallExecuteSequence>

    <Feature Id="Main" Title="Voyager" Level="1">
      <ComponentRef Id="C.MainExe" />
      <ComponentRef Id="C.Loader" />
    </Feature>

  </Product>
</Wix>
