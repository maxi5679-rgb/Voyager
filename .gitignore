# ========================================
# Voyager - Git ignore settings
# ========================================

# Visual Studio / .NET temporary files
.vs/
.idea/
*.user
*.suo

# Build output
[Bb]in/
[Oo]bj/
/publish/
/bundled/
/msi-stage/

# Local backups
/backup/

# Installer output
*.msi
*.wixpdb

# Debug and installation logs
*.log
/make-log.txt
/msi-install-log.txt
/debug.on

# Local build-number state
/buildno.txt

# Local secrets and signing keys
.env
.env.*
!.env.example
*.pfx
*.p12

# Windows temporary files
Thumbs.db
Desktop.ini
*.tmp
*.bak
~$*



# Generated installer binaries
/installer/Voyager.exe
/installer/WebView2Loader.dll

# Retired scripts and stray images (kept locally, not part of the build)
/old/

# CI build output (ci/build.ps1)
/ci-work/
/out/
